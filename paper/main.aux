\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {The base-change test}. The four base-9 runs. Mod 9, base 10's slowest modulus, snaps in 50 steps; mod 5 and mod 8, base 10's fastest, dwell at chance and grind (mod 8 never reaches criterion in budget); mod 6 plateaus at exactly $1/2$---the mod-3 coset, its base-9-local factor---where base 10 plateaued at $1/3$.}}{10}{figure.caption.17}\protected@file@percent }
\newlabel{fig:base9}{{7}{10}{\textbf {The base-change test}. The four base-9 runs. Mod 9, base 10's slowest modulus, snaps in 50 steps; mod 5 and mod 8, base 10's fastest, dwell at chance and grind (mod 8 never reaches criterion in budget); mod 6 plateaus at exactly $1/2$---the mod-3 coset, its base-9-local factor---where base 10 plateaued at $1/3$}{figure.caption.17}{}}
